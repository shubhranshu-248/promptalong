{
  "$schema": "promptalong-tokens/v1",
  "meta": {
    "name": "PromptAlong design tokens",
    "version": "0.2.0",
    "date": "2026-11-27",
    "notes": "Source of truth for packages/ui (P1). Colour pairs listed under contrast were checked to WCAG 2.2 AA: text >= 4.5:1, large text and UI parts >= 3:1. 0.2.0: the light canvas is a cool neutral instead of warm paper; contrast re-checked. Presence p9-p16 added for rooms of 16 (each >= 3:1 on bg, surface and surface-2 in both themes; label >= 4.5:1)."
  },
  "color": {
    "light": {
      "bg": "#F4F5F7",
      "surface": "#FFFFFF",
      "surface-2": "#ECEEF2",
      "surface-sunken": "#EFF1F4",
      "border": "#E2E4E9",
      "border-strong": "#8A8C94",
      "text": "#16171D",
      "text-muted": "#5B5D66",
      "text-on-accent": "#FFFFFF",
      "accent": "#4338CA",
      "accent-hover": "#3730A3",
      "accent-soft": "#E8E7FB",
      "focus-ring": "#4338CA",
      "primary-btn-bg": "#16171D",
      "primary-btn-text": "#FFFFFF",
      "danger": "#B42318",
      "success": "#15803D",
      "warning-bg": "#FFF4D6",
      "warning-text": "#7A4B00",
      "stream-caret": "#16171D",
      "code-bg": "#EFF1F4"
    },
    "dark": {
      "bg": "#111218",
      "surface": "#191B23",
      "surface-2": "#20232D",
      "surface-sunken": "#0C0D12",
      "border": "#2E3240",
      "border-strong": "#6B6F7D",
      "text": "#ECEBE6",
      "text-muted": "#A3A5AE",
      "text-on-accent": "#111218",
      "accent": "#A5A8FF",
      "accent-hover": "#C3C5FF",
      "accent-soft": "#262A4A",
      "focus-ring": "#A5A8FF",
      "primary-btn-bg": "#ECEBE6",
      "primary-btn-text": "#111218",
      "danger": "#FF8A80",
      "success": "#4ADE80",
      "warning-bg": "#3A2E10",
      "warning-text": "#FFD27A",
      "stream-caret": "#ECEBE6",
      "code-bg": "#0C0D12"
    },
    "presence": {
      "notes": "Assigned in this order as people join. Each colour is >= 3:1 against bg and surface in BOTH themes (cursor, selection outline, avatar ring). Name labels use the label colour (>= 4.5:1). Colour is never the only cue: every cursor and authorship span carries a name label or initials. Selections use the colour at 22% alpha.",
      "slots": [
        { "id": "p1", "name": "Coral", "value": "#DD201F", "label": "#FFFFFF" },
        { "id": "p2", "name": "Blue", "value": "#3163F1", "label": "#FFFFFF" },
        { "id": "p3", "name": "Rose", "value": "#D1278D", "label": "#FFFFFF" },
        { "id": "p4", "name": "Sky", "value": "#158EC3", "label": "#16171D" },
        { "id": "p5", "name": "Amber", "value": "#BC7805", "label": "#16171D" },
        { "id": "p6", "name": "Violet", "value": "#8E49E2", "label": "#FFFFFF" },
        { "id": "p7", "name": "Lime", "value": "#67920C", "label": "#16171D" },
        { "id": "p8", "name": "Teal", "value": "#09958A", "label": "#16171D" },
        { "id": "p9", "name": "Orange", "value": "#D2600F", "label": "#16171D" },
        { "id": "p10", "name": "Indigo", "value": "#6466E0", "label": "#FFFFFF" },
        { "id": "p11", "name": "Green", "value": "#2C9446", "label": "#16171D" },
        { "id": "p12", "name": "Brown", "value": "#B0722F", "label": "#16171D" },
        { "id": "p13", "name": "Steel", "value": "#5089BA", "label": "#16171D" },
        { "id": "p14", "name": "Olive", "value": "#8A8A12", "label": "#16171D" },
        { "id": "p15", "name": "Plum", "value": "#B03FC4", "label": "#FFFFFF" },
        { "id": "p16", "name": "Crimson", "value": "#CF3566", "label": "#FFFFFF" }
      ],
      "selection-alpha": 0.22,
      "authorship-underline-px": 2
    },
    "brand": {
      "ink": "#16171D",
      "paper": "#F7F6F2",
      "strand-1": "#DD201F",
      "strand-2": "#3163F1",
      "strand-3": "#BC7805",
      "strand-small-1": "#FF6B5E",
      "strand-small-2": "#7C9BFF",
      "strand-small-3": "#E5A93B"
    }
  },
  "font": {
    "family": {
      "display": "\"Space Grotesk\", \"Space Grotesk Fallback\", system-ui, sans-serif",
      "body": "\"Inter\", \"Inter Fallback\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "mono": "\"JetBrains Mono\", \"JetBrains Mono Fallback\", ui-monospace, \"Cascadia Code\", monospace"
    },
    "licence": "All three are SIL Open Font License 1.1, self-hosted via @fontsource (no third-party font CDN).",
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "size": {
      "xs": "12px",
      "sm": "13px",
      "base": "15px",
      "md": "17px",
      "lg": "20px",
      "xl": "24px",
      "2xl": "32px",
      "3xl": "44px",
      "4xl": "60px"
    },
    "line-height": { "tight": 1.15, "snug": 1.3, "normal": 1.5, "prompt": 1.6 },
    "tracking": { "display": "-0.02em", "normal": "0", "caps": "0.06em" }
  },
  "space": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "24": "96px"
  },
  "radius": { "xs": "4px", "sm": "6px", "md": "10px", "lg": "14px", "xl": "20px", "pill": "999px" },
  "shadow": {
    "light": {
      "sm": "0 1px 2px rgba(22,23,29,.06)",
      "md": "0 4px 16px rgba(22,23,29,.08)",
      "lg": "0 12px 40px rgba(22,23,29,.14)"
    },
    "dark": {
      "sm": "0 1px 2px rgba(0,0,0,.4)",
      "md": "0 4px 16px rgba(0,0,0,.45)",
      "lg": "0 12px 40px rgba(0,0,0,.55)"
    }
  },
  "size": {
    "touch-target-min": "44px",
    "control-h-sm": "32px",
    "control-h-md": "40px",
    "control-h-lg": "48px",
    "topbar-h": "56px",
    "sidebar-w": "280px",
    "context-panel-w": "360px",
    "content-max": "1200px",
    "breakpoint-mobile-max": "767px",
    "breakpoint-tablet-max": "1099px"
  },
  "motion": {
    "duration": { "instant": "0ms", "fast": "150ms", "base": "200ms", "slow": "300ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)"
    },
    "rules": [
      "Remote cursors and incoming text are never animated with a delay; they render on the next frame.",
      "Stream tokens appear as they arrive; only the caret blinks (530ms steps).",
      "Panels slide 200ms; toasts and popovers 150ms; branch-tree layout changes 300ms."
    ],
    "reduced-motion": {
      "media": "(prefers-reduced-motion: reduce)",
      "duration-override": "0ms",
      "rules": [
        "All slides and fades become instant.",
        "Stream caret stops blinking (solid).",
        "Cursor name labels stay visible instead of fading out."
      ]
    }
  },
  "z": { "base": 0, "sticky": 10, "panel": 20, "popover": 40, "dialog": 50, "toast": 60 },
  "contrast-checks": {
    "light": {
      "text/bg": 16.54,
      "text-muted/bg": 6.06,
      "text-muted/surface": 6.56,
      "accent/bg": 7.31,
      "text-on-accent/accent": 7.9,
      "border-strong/bg (inputs)": 3.1,
      "danger/surface": 6.57,
      "success/surface": 5.02
    },
    "dark": {
      "text/bg": 15.66,
      "text-muted/bg": 7.61,
      "text-muted/surface": 7.0,
      "accent/bg": 8.58,
      "text-on-accent/accent": 8.58,
      "border-strong/bg (inputs)": 3.73,
      "border-strong/surface (inputs)": 3.43,
      "danger/bg": 8.19,
      "success/bg": 10.73
    }
  }
}
