    "build:e2e": "VITE_REALTIME=relay VITE_RELAY_URL=ws://localhost:8787 tsc -p tsconfig.json && VITE_REALTIME=relay VITE_RELAY_URL=ws://localhost:8787 vite build --outDir dist-e2e",
