# Copy to apps/web/.env.local and fill in. Never commit real values.
# Only VITE_* variables reach the browser; both values below are public by design: every table is
# protected by row-level security and every write goes through checked SQL functions. Never put the
# database password or the service-role key here. Model keys never go here either: each person
# enters their own key in the app and it stays in their browser.
# Set-up (local stack or hosted project): docs/runbooks/database.md

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: force how rooms sync - supabase | relay | none. By default Supabase is used when the two
# values above are set, the local relay (pnpm relay) in development, and "this device only" otherwise.
# VITE_REALTIME=relay
# VITE_RELAY_URL=ws://localhost:8787
