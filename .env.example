# Copy to apps/web/.env.local and fill in. Never commit real values.
# Only VITE_* variables reach the browser; both values below are public by design
# (the anon key is protected by row-level security). Model keys never go here:
# each person enters their own key in the app and it stays in their browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
